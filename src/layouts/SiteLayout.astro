---
const { lang, title, description, path = `/${lang}/` } = Astro.props;
const siteUrl = 'https://supraim.github.io';
const canonicalUrl = new URL(path, siteUrl).toString();
const alternateEs = new URL('/es/', siteUrl).toString();
const alternateEn = new URL('/en/', siteUrl).toString();
const socialImage = new URL(`/images/social/supraim-${lang}.jpg`, siteUrl).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${siteUrl}/#website`, url: siteUrl, name: 'Supraim', inLanguage: lang },
    { '@type': 'Organization', '@id': `${siteUrl}/#organization`, name: 'Supraim', url: siteUrl, logo: `${siteUrl}/favicon.png`, sameAs: ['https://github.com/supraim', 'https://www.linkedin.com/in/nico-vaz/'] },
    { '@type': 'Person', '@id': `${siteUrl}/#nicolas-vazquez`, name: 'Nicolás Vazquez', url: siteUrl, jobTitle: lang === 'es' ? 'Desarrollador independiente' : 'Independent developer', worksFor: { '@id': `${siteUrl}/#organization` }, sameAs: ['https://github.com/supraim', 'https://www.linkedin.com/in/nico-vaz/'], knowsAbout: ['Android development', 'Kotlin', 'React Native', 'React', 'Angular', '.NET', 'Jakarta EE'] }
  ]
};
const copy = lang === 'es'
  ? { skip: 'Saltar al contenido', home: 'Inicio', apps: 'Aplicaciones', about: 'Sobre mí', process: 'Proceso', contact: 'Contacto', appearance: 'Apariencia', light: 'Claro', dark: 'Oscuro', vivid: 'Expresivo', language: 'Idioma', footer: 'Hecho con intención por', backTop: 'Volver arriba', imageClose: 'Cerrar imagen ampliada' }
  : { skip: 'Skip to content', home: 'Home', apps: 'Apps', about: 'About', process: 'Approach', contact: 'Contact', appearance: 'Appearance', light: 'Light', dark: 'Dark', vivid: 'Expressive', language: 'Language', footer: 'Made with intention by', backTop: 'Back to top', imageClose: 'Close enlarged image' };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Nicolás Vazquez" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={alternateEs} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={alternateEs} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Supraim" />
    <meta property="og:locale" content={lang === 'es' ? 'es_UY' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="theme-color" content="#f5f4f0" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <title>{title}</title>
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('supraim-theme');
        if (savedTheme === 'light' || savedTheme === 'dark' || savedTheme === 'expressive') {
          document.documentElement.dataset.theme = savedTheme;
        }
      } catch {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="reading-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#main">{copy.skip}</a>
    <header class="site-header wrap">
      <a class="brand" href={lang === 'es' ? '/es/' : '/en/'} aria-label="Nicolás Vazquez — Supraim">
        <span class="brand-mark" aria-hidden="true"><img src="/images/brand/supraim-symbol-mark.png" alt="" width="32" height="32" /></span>
        <span class="brand-name">Nicolás Vazquez <span class="brand-divider">/</span> Supraim</span>
      </a>
      <nav class="main-nav" aria-label={lang === 'es' ? 'Navegación principal' : 'Main navigation'}>
        <a href={lang === 'es' ? '/es/' : '/en/'}>{copy.home}</a>
        <a href={lang === 'es' ? '/es/#apps' : '/en/#apps'}>{copy.apps}</a>
        <a href={lang === 'es' ? '/es/#about' : '/en/#about'}>{copy.about}</a>
        <a href={lang === 'es' ? '/es/#process' : '/en/#process'}>{copy.process}</a>
        <a href={lang === 'es' ? '/es/#contact' : '/en/#contact'}>{copy.contact}</a>
      </nav>
      <div class="header-tools">
        <div class="language-switch" aria-label={copy.language}>
          <a href="/es/" aria-current={lang === 'es' ? 'page' : undefined}>ES</a><span>/</span><a href="/en/" aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
        </div>
        <details class="theme-menu">
          <summary aria-label={copy.appearance} title={copy.appearance}><span aria-hidden="true">◐</span><span class="theme-label">{copy.appearance}</span></summary>
          <div class="theme-options" role="group" aria-label={copy.appearance}>
            <button type="button" data-theme-choice="light"><i class="theme-swatch swatch-light" aria-hidden="true"></i>{copy.light}</button>
            <button type="button" data-theme-choice="dark"><i class="theme-swatch swatch-dark" aria-hidden="true"></i>{copy.dark}</button>
            <button type="button" data-theme-choice="expressive"><i class="theme-swatch swatch-expressive" aria-hidden="true"></i>{copy.vivid}</button>
          </div>
        </details>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <dialog class="media-viewer" id="media-viewer" aria-label={lang === 'es' ? 'Vista ampliada de imagen' : 'Enlarged image viewer'}>
      <div class="media-viewer-bar"><span>{lang === 'es' ? 'VISTA DE IMAGEN' : 'IMAGE PREVIEW'}</span><span class="media-viewer-count" aria-live="polite"></span><button class="media-viewer-close" type="button" aria-label={copy.imageClose}>×</button></div>
      <div class="media-viewer-stage"><button class="media-viewer-nav media-viewer-prev" type="button" aria-label={lang === 'es' ? 'Imagen anterior' : 'Previous image'}>‹</button><img alt="" /><button class="media-viewer-nav media-viewer-next" type="button" aria-label={lang === 'es' ? 'Imagen siguiente' : 'Next image'}>›</button></div>
      <p class="media-viewer-caption" aria-live="polite"></p>
    </dialog>
    <button class="back-to-top" id="back-to-top" type="button" aria-label={copy.backTop} title={copy.backTop} hidden>↑</button>
    <footer class="site-footer wrap">
      <a class="footer-brand" href={lang === 'es' ? '/es/' : '/en/'}>Nicolás Vazquez <span>· Supraim</span></a>
      <span>{copy.footer} <a href="mailto:supraim.dev@gmail.com">supraim.dev@gmail.com</a></span>
      <a href="/app-ads.txt">app-ads.txt ↗</a>
    </footer>
    <script>
      const key = 'supraim-theme';
      const applyTheme = (theme) => {
        document.documentElement.dataset.theme = theme;
        localStorage.setItem(key, theme);
        const themeColors = { light: '#f5f4f0', dark: '#121613', expressive: '#fbf5eb' };
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', themeColors[theme] || themeColors.light);
        document.querySelectorAll('[data-theme-choice]').forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.themeChoice === theme));
        });
      };
      const savedTheme = localStorage.getItem(key);
      if (savedTheme) document.documentElement.dataset.theme = savedTheme;
      if (savedTheme) document.querySelector('meta[name="theme-color"]')?.setAttribute('content', { light: '#f5f4f0', dark: '#121613', expressive: '#fbf5eb' }[savedTheme] || '#f5f4f0');
      document.querySelectorAll('.language-switch a').forEach((link) => {
        link.addEventListener('click', () => localStorage.setItem('supraim-language', link.textContent.trim().toLowerCase()));
      });
      document.querySelectorAll('[data-theme-choice]').forEach((button) => {
        button.addEventListener('click', () => applyTheme(button.dataset.themeChoice));
      });
      document.querySelector('.theme-menu')?.addEventListener('toggle', (event) => {
        if (event.target.open) {
          const current = document.documentElement.dataset.theme || 'light';
          document.querySelectorAll('[data-theme-choice]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.themeChoice === current)));
        }
      });
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -24px 0px' });
        document.querySelectorAll('[data-reveal]').forEach((element, index) => {
          element.classList.add('reveal-ready');
          element.style.setProperty('--reveal-delay', `${Math.min(index % 5, 4) * 55}ms`);
          revealObserver.observe(element);
        });
      }
      const viewer = document.querySelector('#media-viewer');
      const viewerImage = viewer?.querySelector('img');
      const viewerCaption = viewer?.querySelector('.media-viewer-caption');
      const viewerCount = viewer?.querySelector('.media-viewer-count');
      const viewerPrev = viewer?.querySelector('.media-viewer-prev');
      const viewerNext = viewer?.querySelector('.media-viewer-next');
      let viewerItems = [];
      let viewerIndex = 0;
      const showViewerItem = (index) => {
        if (!viewer || !viewerImage || !viewerItems.length) return;
        viewerIndex = (index + viewerItems.length) % viewerItems.length;
        const item = viewerItems[viewerIndex];
        viewerImage.src = item.dataset.lightboxSrc || '';
        viewerImage.alt = item.dataset.lightboxAlt || '';
        if (viewerCaption) viewerCaption.textContent = item.dataset.caption || '';
        if (viewerCount) viewerCount.textContent = viewerItems.length > 1 ? `${viewerIndex + 1} / ${viewerItems.length}` : '';
        [viewerPrev, viewerNext].forEach((button) => { if (button) button.hidden = viewerItems.length < 2; });
      };
      document.querySelectorAll('[data-lightbox-src]').forEach((trigger) => {
        trigger.addEventListener('click', () => {
          if (!viewer || !viewerImage) return;
          const group = trigger.dataset.lightboxGroup;
          viewerItems = group ? [...document.querySelectorAll(`[data-lightbox-group="${group}"]`)] : [trigger];
          showViewerItem(Math.max(0, viewerItems.indexOf(trigger)));
          viewer.showModal();
        });
      });
      viewerPrev?.addEventListener('click', () => showViewerItem(viewerIndex - 1));
      viewerNext?.addEventListener('click', () => showViewerItem(viewerIndex + 1));
      viewer?.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') { event.preventDefault(); showViewerItem(viewerIndex - 1); }
        if (event.key === 'ArrowRight') { event.preventDefault(); showViewerItem(viewerIndex + 1); }
      });
      viewer?.querySelector('.media-viewer-close')?.addEventListener('click', () => viewer.close());
      viewer?.addEventListener('click', (event) => { if (event.target === viewer) viewer.close(); });
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reducedMotion) {
        document.querySelectorAll('[data-name-rotator]').forEach((rotator) => {
          const names = (rotator.dataset.names || '').split('|').filter(Boolean);
          let activeName = 0;
          window.setInterval(() => {
            if (names.length < 2) return;
            rotator.classList.add('is-changing');
            window.setTimeout(() => {
              activeName = (activeName + 1) % names.length;
              rotator.textContent = names[activeName];
              rotator.classList.remove('is-changing');
            }, 210);
          }, 2800);
        });
      }
      document.querySelectorAll('[data-carousel]').forEach((carousel) => {
        const slides = [...carousel.querySelectorAll('[data-slide]')];
        const dots = [...carousel.querySelectorAll('[data-slide-to]')];
        const caption = carousel.querySelector('[data-carousel-caption]');
        const toggle = carousel.parentElement.querySelector('[data-carousel-toggle]');
        let activeIndex = 0;
        let timer;
        let pausedByUser = false;
        let interactionPaused = false;
        const showSlide = (nextIndex) => {
          activeIndex = (nextIndex + slides.length) % slides.length;
          slides.forEach((slide, index) => {
            const active = index === activeIndex;
            slide.classList.toggle('is-active', active);
            slide.setAttribute('aria-hidden', String(!active));
            slide.inert = !active;
            dots[index]?.setAttribute('aria-pressed', String(active));
          });
          if (caption) caption.textContent = slides[activeIndex]?.dataset.caption || '';
        };
        const stopRotation = () => window.clearInterval(timer);
        const startRotation = () => {
          stopRotation();
          if (!reducedMotion && !pausedByUser && !interactionPaused && !document.hidden) timer = window.setInterval(() => showSlide(activeIndex + 1), Number(carousel.dataset.interval) || 5600);
        };
        if (reducedMotion && toggle) toggle.hidden = true;
        toggle?.addEventListener('click', () => {
          pausedByUser = !pausedByUser;
          toggle.setAttribute('aria-pressed', String(pausedByUser));
          toggle.setAttribute('aria-label', pausedByUser ? (document.documentElement.lang === 'es' ? 'Reanudar carrusel' : 'Resume carousel') : (document.documentElement.lang === 'es' ? 'Pausar carrusel' : 'Pause carousel'));
          toggle.textContent = pausedByUser ? '▶' : 'Ⅱ';
          startRotation();
        });
        carousel.querySelector('[data-carousel-prev]')?.addEventListener('click', () => { showSlide(activeIndex - 1); startRotation(); });
        carousel.querySelector('[data-carousel-next]')?.addEventListener('click', () => { showSlide(activeIndex + 1); startRotation(); });
        dots.forEach((dot) => dot.addEventListener('click', () => { showSlide(Number(dot.dataset.slideTo)); startRotation(); }));
        const interactionSurface = carousel.parentElement;
        interactionSurface.addEventListener('mouseenter', () => { interactionPaused = true; stopRotation(); });
        interactionSurface.addEventListener('mouseleave', () => { interactionPaused = false; startRotation(); });
        interactionSurface.addEventListener('focusin', () => { interactionPaused = true; stopRotation(); });
        interactionSurface.addEventListener('focusout', (event) => { if (!interactionSurface.contains(event.relatedTarget)) { interactionPaused = false; startRotation(); } });
        let touchStartX = 0;
        carousel.addEventListener('pointerdown', (event) => { touchStartX = event.clientX; }, { passive: true });
        carousel.addEventListener('pointerup', (event) => {
          const distance = event.clientX - touchStartX;
          if (Math.abs(distance) > 48) { showSlide(activeIndex + (distance < 0 ? 1 : -1)); startRotation(); }
        }, { passive: true });
        document.addEventListener('visibilitychange', () => document.hidden ? stopRotation() : startRotation());
        showSlide(0);
        startRotation();
      });
      if (!reducedMotion && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        document.querySelectorAll('.app-card').forEach((card) => {
          card.addEventListener('pointermove', (event) => {
            const bounds = card.getBoundingClientRect();
            const x = (event.clientX - bounds.left) / bounds.width;
            const y = (event.clientY - bounds.top) / bounds.height;
            card.style.setProperty('--spot-x', `${x * 100}%`);
            card.style.setProperty('--spot-y', `${y * 100}%`);
            card.style.setProperty('--tilt-x', `${(x - .5) * 3.5}deg`);
            card.style.setProperty('--tilt-y', `${(.5 - y) * 3.5}deg`);
          });
          card.addEventListener('pointerleave', () => {
            card.style.setProperty('--tilt-x', '0deg');
            card.style.setProperty('--tilt-y', '0deg');
          });
        });
      }
      const sectionLinks = [...document.querySelectorAll('.main-nav a[href*="#"]')];
      const navTargets = [...document.querySelectorAll('main section[id]')].map((section) => {
        const navId = section.id === 'featured' ? 'apps' : section.id === 'skills' ? 'process' : section.id;
        const link = sectionLinks.find((candidate) => candidate.hash === `#${navId}`);
        return link ? { section, link } : null;
      }).filter(Boolean);
      const homeLink = [...document.querySelectorAll('.main-nav a')].find((link) => !link.hash);
      const topButton = document.querySelector('#back-to-top');
      const siteFooter = document.querySelector('.site-footer');
      let scrollTicking = false;
      const updateScrollUi = () => {
        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
        document.documentElement.style.setProperty('--scroll-progress', `${scrollable > 0 ? window.scrollY / scrollable : 0}`);
        if (topButton) {
          topButton.hidden = window.scrollY < 520;
          topButton.classList.toggle('is-above-footer', Boolean(siteFooter && siteFooter.getBoundingClientRect().top < window.innerHeight - 18));
        }
        const headerOffset = (document.querySelector('.site-header')?.offsetHeight || 0) + 110;
        const marker = window.scrollY + headerOffset;
        let activeLink = homeLink;
        for (const target of navTargets) {
          if (target.section.getBoundingClientRect().top + window.scrollY <= marker) activeLink = target.link;
        }
        if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - Math.max(48, headerOffset)) {
          activeLink = sectionLinks.find((link) => link.hash === '#contact') || activeLink;
        }
        document.querySelectorAll('.main-nav a').forEach((link) => {
          if (link === activeLink) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
        scrollTicking = false;
      };
      window.addEventListener('scroll', () => {
        if (!scrollTicking) { window.requestAnimationFrame(updateScrollUi); scrollTicking = true; }
      }, { passive: true });
      window.addEventListener('resize', () => {
        if (!scrollTicking) { window.requestAnimationFrame(updateScrollUi); scrollTicking = true; }
      }, { passive: true });
      updateScrollUi();
      topButton?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    </script>
    <style is:global>
      :root{font-family:'Manrope',sans-serif;color-scheme:light;--bg:#f5f4f0;--surface:#fff;--surface-alt:#ecebe6;--text:#20231f;--muted:#6d716a;--line:#dcded7;--accent:#326b58;--accent-contrast:#fff;--hero-wash:#e6ece4;--glow:rgba(50,107,88,.12);--shadow:0 24px 70px #22291e0c;scroll-behavior:smooth}
      :root[data-theme="dark"]{color-scheme:dark;--bg:#121613;--surface:#1b211d;--surface-alt:#252d27;--text:#f1f3ed;--muted:#a1aaa0;--line:#343e36;--accent:#a7d6b5;--accent-contrast:#122017;--hero-wash:#202b24;--glow:rgba(128,214,164,.14);--shadow:0 24px 70px #0004}
      :root[data-theme="expressive"]{color-scheme:light;--bg:#fbf5eb;--surface:#fffdf9;--surface-alt:#f4e5d9;--text:#281c33;--muted:#726476;--line:#e4d5db;--accent:#8c3cd1;--accent-contrast:#fff;--hero-wash:#f4d8bf;--glow:rgba(140,60,209,.2);--shadow:0 24px 70px #784b6918}
      *{box-sizing:border-box}html{background:var(--bg);scroll-padding-top:100px}body{margin:0;background:var(--bg);color:var(--text);transition:background .25s,color .25s;font-size:15px;line-height:1.65}a{color:inherit;text-decoration:none}button{font:inherit}::selection{background:var(--accent);color:var(--accent-contrast)}.wrap{width:min(1120px,calc(100% - 48px));margin-inline:auto}.skip-link{position:absolute;top:-60px;left:20px;padding:10px;background:var(--surface);z-index:10}.skip-link:focus{top:10px}.reading-progress{position:fixed;inset:0 0 auto;height:3px;z-index:50;background:linear-gradient(90deg,var(--accent),#5bbfbd);transform:scaleX(var(--scroll-progress,0));transform-origin:left;will-change:transform}
      .site-header{position:sticky;top:0;z-index:30;height:88px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);gap:24px;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}.brand{display:flex;align-items:center;gap:11px;font-size:13px;font-weight:800;letter-spacing:-.03em;white-space:nowrap}.brand-mark{width:32px;height:32px;display:grid;place-items:center;overflow:hidden;border:1px solid var(--line);border-radius:10px;background:linear-gradient(145deg,var(--surface),var(--surface-alt));box-shadow:0 4px 12px #0000000d}.brand-mark img{display:block;width:47px;height:47px;object-fit:contain;filter:saturate(1.06)}.brand-divider{font-weight:400;color:var(--muted);margin-inline:3px}.main-nav,.header-tools{display:flex;align-items:center;gap:24px}.main-nav a,.language-switch,.theme-label{font-size:12px;color:var(--muted);font-weight:600}.main-nav a{position:relative}.main-nav a::after{content:'';position:absolute;left:0;right:100%;bottom:-5px;height:1px;background:var(--accent);transition:right .2s}.main-nav a:hover::after,.main-nav a[aria-current="location"]::after{right:0}.main-nav a[aria-current="location"]{color:var(--text)}.main-nav a:hover,.language-switch a:hover{color:var(--text)}.header-tools{gap:16px}.language-switch{display:flex;gap:7px;align-items:center;font-family:'DM Mono',monospace}.language-switch a[aria-current="page"]{color:var(--text)}.language-switch span{opacity:.4}.theme-menu{position:relative}.theme-menu summary{cursor:pointer;list-style:none;display:flex;align-items:center;gap:7px;padding:8px 10px;border:1px solid var(--line);border-radius:8px;color:var(--muted);font-size:13px;transition:background-color .2s,border-color .2s}.theme-menu summary:hover{background:var(--surface-alt);border-color:var(--accent)}.theme-menu summary::-webkit-details-marker{display:none}.theme-options{position:absolute;right:0;top:44px;z-index:4;width:160px;padding:6px;background:var(--surface);border:1px solid var(--line);border-radius:10px;box-shadow:var(--shadow);animation:pop-up .16s ease-out}.theme-options button{width:100%;padding:8px 10px;border:0;border-radius:6px;background:transparent;color:var(--text);text-align:left;font-size:12px;cursor:pointer;transition:background-color .2s}.theme-options button:hover,.theme-options button[aria-pressed="true"]{background:var(--surface-alt)}.theme-swatch{display:inline-block;flex:0 0 12px;width:12px;height:12px;margin-right:5px;border:1px solid var(--line);border-radius:50%}.swatch-light{background:linear-gradient(135deg,#fff 50%,#dfe6dc 50%)}.swatch-dark{background:linear-gradient(135deg,#18201b 50%,#a7d6b5 50%)}.swatch-expressive{background:linear-gradient(135deg,#8c3cd1 50%,#f4d8bf 50%)}

---
import SiteLayout from '../../layouts/SiteLayout.astro';
const apps = [
  { name: 'SmartScan QR & Barcode Scanner', kind: 'PRODUCTIVITY · UTILITIES', icon: '/images/apps/smartscan-icon.jpg', screenshot: '/images/apps/smartscan-screen.jpg', lightbox: '/images/apps/smartscan-screen-full.jpg', imageAlt: 'SmartScan QR & Barcode Scanner scanning screen', preview: '#071b2b', description: 'Scan and create QR codes and barcodes, import images, and keep scan history and favorites on your device.', privacyEs: '/smartscan/privacy.es.html', privacyEn: '/smartscan/privacy.html', play: 'https://play.google.com/store/apps/details?id=com.supraim.smartscan' },
  { name: 'Attentio: Focus & Pomodoro', kind: 'FOCUS · DIGITAL WELLBEING', icon: '/images/apps/attentio-icon.jpg', screenshot: '/images/apps/attentio-screen.jpg', lightbox: '/images/apps/attentio-screen-full.jpg', imageAlt: 'Attentio: Focus & Pomodoro session customization screen', preview: '#eee9df', description: 'A customizable Pomodoro timer with daily goals, streaks, and stats to help you stay focused.', privacyEs: '/attentio/privacy.es.html', privacyEn: '/attentio/privacy.html', play: 'https://play.google.com/store/apps/details?id=com.supraim.attentio' },
];
---
<SiteLayout lang="en" title="Nicolás Vazquez — Supraim | Apps for everyday life" description="Portfolio of Nicolás Vazquez, app developer at Supraim. Explore SmartScan, Attentio and World Radio, and find their official documents.">
  <section class="hero" data-reveal>
    <div>
      <span class="eyebrow">INDEPENDENT DEVELOPMENT · SUPRAIM</span>
      <div class="availability-chip"><span aria-hidden="true"></span> Open to employment, freelance, and collaboration</div>
      <h1>Hi, I’m <span class="hero-identity" data-name-rotator data-names="Nicolás|Supraim" aria-label="Nicolás Vazquez, Supraim">Nicolás</span>.<br />I build apps for <em>real life.</em></h1>
      <p class="hero-copy">I design and build useful, thoughtful, easy-to-use mobile apps. Supraim is where these projects take shape.</p>
      <div class="hero-actions"><a class="button" href="#apps">Explore the apps <span aria-hidden="true">↘</span></a><a class="text-link" href="#about">A little about me <span>↗</span></a></div>
    </div>
    <div class="hero-art" aria-hidden="true"><div class="orbit"></div><div class="orbit-logos"><span class="orbit-badge" data-tech="Kotlin"><img src="/images/technologies/kotlin.svg" alt="" /></span><span class="orbit-badge" data-tech="React"><img src="/images/technologies/react.svg" alt="" /></span><span class="orbit-badge" data-tech="Angular"><img src="/images/technologies/angular.svg" alt="" /></span><span class="orbit-badge" data-tech=".NET"><img src="/images/technologies/dotnet.svg" alt="" /></span></div><div class="monogram"><img src="/images/brand/supraim-symbol.png" alt="" width="184" height="184" /></div></div>
  </section>
  <section class="featured-section" id="featured" data-reveal>
    <div class="featured-visual"><span class="featured-label">FEATURED APP</span><button class="gallery-pause" type="button" data-carousel-toggle aria-label="Pause carousel" aria-pressed="false">Ⅱ</button><div class="featured-gallery" data-carousel data-interval="5600" role="region" aria-roledescription="carousel" aria-label="World Radio screenshots"><div class="gallery-stage">
      <button class="gallery-slide is-active" type="button" data-slide data-caption="Browse live stations from around the world" data-lightbox-group="world-radio" data-lightbox-src="/images/apps/worldradio-screen-full.jpg" data-lightbox-alt="World Radio station catalog" aria-label="Enlarge World Radio screenshot 1" aria-roledescription="slide"><img src="/images/apps/worldradio-screen.jpg" alt="" width="240" height="480" decoding="async" /><span>Enlarge ↗</span></button>
      <button class="gallery-slide" type="button" data-slide data-caption="Find music by genre" data-lightbox-group="world-radio" data-lightbox-src="/images/apps/worldradio-screen-full-2.jpg" data-lightbox-alt="Browse music genres in World Radio" aria-label="Enlarge World Radio screenshot 2" aria-roledescription="slide" aria-hidden="true" inert><img src="/images/apps/worldradio-screen-2.jpg" alt="" width="240" height="480" loading="lazy" decoding="async" /><span>Enlarge ↗</span></button>
      <button class="gallery-slide" type="button" data-slide data-caption="Discover stations by country" data-lightbox-group="world-radio" data-lightbox-src="/images/apps/worldradio-screen-full-3.jpg" data-lightbox-alt="Select countries in World Radio" aria-label="Enlarge World Radio screenshot 3" aria-roledescription="slide" aria-hidden="true" inert><img src="/images/apps/worldradio-screen-3.jpg" alt="" width="240" height="480" loading="lazy" decoding="async" /><span>Enlarge ↗</span></button>
    </div><div class="gallery-controls"><button type="button" data-carousel-prev aria-label="Previous screenshot">‹</button><div class="gallery-dots" role="group" aria-label="Choose screenshot"><button type="button" data-slide-to="0" aria-label="Show screenshot 1" aria-pressed="true"></button><button type="button" data-slide-to="1" aria-label="Show screenshot 2" aria-pressed="false"></button><button type="button" data-slide-to="2" aria-label="Show screenshot 3" aria-pressed="false"></button></div><button type="button" data-carousel-next aria-label="Next screenshot">›</button><span class="gallery-caption" data-carousel-caption aria-live="off">Browse live stations from around the world</span></div></div></div>
    <div class="featured-copy"><span class="section-kicker">FEATURED PROJECT · AUDIO</span><h2>World Radio</h2><p>Discover live radio stations from around the world. Browse by country, genre, or popularity, find music, news, and talk shows, and save your favorites.</p><div class="feature-tags"><span>Global stations</span><span>Search and categories</span><span>Favorites</span></div><div class="featured-links"><a class="button" href="https://play.google.com/store/apps/details?id=com.supraim.worldradio" target="_blank" rel="noopener noreferrer">View on Google Play ↗</a><a href="/worldradio/privacy.html">Privacy (EN)</a><a href="/worldradio/privacy.es.html">ES</a></div></div>
  </section>
  <section class="section" id="apps" data-reveal>
    <div class="section-heading"><div><span class="section-kicker">01 / SELECTED WORK</span><h2>Applications</h2></div><a class="text-link" href="https://play.google.com/store/apps/dev?id=7088773385933324272" target="_blank" rel="noopener noreferrer">View developer profile <span>↗</span></a></div>
    <div class="app-grid app-grid-two">
      {apps.map((app) => <article class="app-card" data-reveal style={`--app-preview:${app.preview}`}><div class="app-top"><img class="app-icon" src={app.icon} alt="" width="40" height="40" loading="lazy" /><span class="app-type">{app.kind}</span></div><div class="app-preview"><button class="preview-trigger" type="button" data-lightbox-src={app.lightbox} data-lightbox-alt={app.imageAlt} aria-label={`Enlarge ${app.name} screenshot`}><img src={app.screenshot} alt={app.imageAlt} width="240" height="480" loading="lazy" decoding="async" /><span>Enlarge ↗</span></button></div><h3>{app.name}</h3><p>{app.description}</p><div class="app-links"><a href={app.play} target="_blank" rel="noopener noreferrer">View on Google Play ↗</a><a href={app.privacyEn}>Privacy (EN)</a><a href={app.privacyEs}>ES</a></div></article>)}
    </div>
  </section>
  <section class="section" id="about" data-reveal>
    <div class="about-row"><div><span class="section-kicker">02 / ABOUT</span><h2>Useful ideas, simple experiences.</h2></div><div class="about-meta"><p>I’m Nicolás Vazquez, the independent developer behind Supraim and a technology enthusiast passionate about software development in all its forms: mobile, web, desktop apps, and bots. Android is my current focus, and I’m open to development projects across different areas.</p><div class="meta-line"><span>Current focus</span><span>Android · Kotlin</span></div><div class="meta-line"><span>Open to</span><span>Employment · Freelance · Collaboration</span></div><div class="social-links"><a href="https://github.com/supraim" target="_blank" rel="noopener noreferrer">GitHub <span>↗</span></a><a href="https://www.linkedin.com/in/nico-vaz/" target="_blank" rel="noopener noreferrer">LinkedIn <span>↗</span></a></div></div></div>
  </section>
  <section class="section" id="process" data-reveal>
    <div class="section-heading process-heading"><div><span class="section-kicker">03 / IDEA TO PRODUCTION</span><h2>The full product journey.</h2><p>From the first concept to a published app.</p></div></div>
    <div class="process-grid"><article><span>01</span><h3>Idea</h3><p>Define the problem, purpose, and scope of the product.</p></article><article><span>02</span><h3>Development</h3><p>Design and build the experience, logic, and features.</p></article><article><span>03</span><h3>Release readiness</h3><p>Handle technical requirements, Play policies, and required documentation.</p></article><article><span>04</span><h3>Launch</h3><p>Complete the reviews and take the project into production.</p></article></div>
  </section>
  <section class="section" id="skills" data-reveal>
    <div class="section-heading tech-heading"><div><span class="section-kicker">04 / TECHNOLOGIES</span><h2>Open to building across platforms.</h2><p>Android is my current focus; I enjoy exploring different areas of software development.</p></div></div>
    <div class="skills-grid">
      <article data-reveal><span>01 / MOBILE</span><h3>Mobile</h3><div class="tech-list"><div class="tech-item"><span class="tech-logo"><img src="/images/technologies/kotlin.svg" alt="" loading="lazy" /></span><span>Kotlin</span></div><div class="tech-item"><span class="tech-logo"><img src="/images/technologies/react.svg" alt="" loading="lazy" /></span><span>React Native</span></div></div></article>
      <article data-reveal><span>02 / WEB</span><h3>Web</h3><div class="tech-list"><div class="tech-item"><span class="tech-logo"><img src="/images/technologies/react.svg" alt="" loading="lazy" /></span><span>React</span></div><div class="tech-item"><span class="tech-logo"><img src="/images/technologies/angular.svg" alt="" loading="lazy" /></span><span>Angular</span></div></div></article>
      <article data-reveal><span>03 / DESKTOP</span><h3>Desktop</h3><div class="tech-list"><div class="tech-item"><span class="tech-logo"><img src="/images/technologies/java.svg" alt="" loading="lazy" /></span><span>Java</span></div><div class="tech-item"><span class="tech-logo"><img src="/images/technologies/csharp.svg" alt="" loading="lazy" /></span><span>C#</span></div><div class="tech-item"><span class="tech-logo"><img src="/images/technologies/c.svg" alt="" loading="lazy" /></span><span>C</span></div><div class="tech-item"><span class="tech-logo"><img src="/images/technologies/cplusplus.svg" alt="" loading="lazy" /></span><span>C++</span></div></div></article>
      <article data-reveal><span>04 / ENTERPRISE</span><h3>Enterprise platforms</h3><div class="tech-list"><div class="tech-item"><span class="tech-logo"><img src="/images/technologies/dotnet.svg" alt="" loading="lazy" /></span><span>.NET</span></div><div class="tech-item"><span class="tech-logo tech-logo-wide"><img src="/images/technologies/jakartaee.svg" alt="" loading="lazy" /></span><span>Jakarta EE</span></div></div></article>
    </div>
  </section>
  <section class="section" id="contact" data-reveal>
    <div class="contact-panel"><div><span class="section-kicker">05 / CONTACT</span><h2>Let’s talk.</h2><p>Open to employment, freelance projects, and collaborations.</p></div><div class="contact-links"><a class="contact-email" href="mailto:supraim.dev@gmail.com"><span>supraim.dev@gmail.com</span><span class="contact-arrow" aria-hidden="true">↗</span></a><a href="https://github.com/supraim" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="https://www.linkedin.com/in/nico-vaz/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div></div>
  </section>
</SiteLayout>

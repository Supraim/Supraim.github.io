---
import SiteLayout from '../../layouts/SiteLayout.astro';
const apps = [
  { name: 'SmartScan: escáner QR y de códigos de barras', kind: 'PRODUCTIVIDAD · UTILIDADES', icon: '/images/apps/smartscan-icon.jpg', screenshot: '/images/apps/smartscan-screen.jpg', lightbox: '/images/apps/smartscan-screen-full.jpg', imageAlt: 'Pantalla de escaneo de SmartScan', preview: '#071b2b', description: 'Escanea y crea códigos QR y de barras, importa imágenes y guarda tus lecturas y favoritos en el dispositivo.', privacyEs: '/smartscan/privacy.es.html', privacyEn: '/smartscan/privacy.html', play: 'https://play.google.com/store/apps/details?id=com.supraim.smartscan' },
  { name: 'Attentio: enfoque y Pomodoro', kind: 'ENFOQUE · BIENESTAR DIGITAL', icon: '/images/apps/attentio-icon.jpg', screenshot: '/images/apps/attentio-screen.jpg', lightbox: '/images/apps/attentio-screen-full.jpg', imageAlt: 'Pantalla de personalización de sesiones de Attentio', preview: '#eee9df', description: 'Temporizador Pomodoro personalizable con objetivos diarios, rachas y estadísticas para mantener el foco.', privacyEs: '/attentio/privacy.es.html', privacyEn: '/attentio/privacy.html', play: 'https://play.google.com/store/apps/details?id=com.supraim.attentio' },
];
---
<SiteLayout lang="es" title="Nicolás Vazquez — Supraim | Apps para el día a día" description="Portfolio de Nicolás Vazquez, desarrollador de apps en Supraim. Explora SmartScan, Attentio y World Radio, y consulta sus documentos oficiales.">
  <section class="hero" data-reveal>
    <div>
      <span class="eyebrow">DESARROLLO INDEPENDIENTE · SUPRAIM</span>
      <div class="availability-chip"><span aria-hidden="true"></span> Disponible para empleo, freelance y colaboración</div>
      <h1>Hola, soy <span class="hero-identity" data-name-rotator data-names="Nicolás|Supraim" aria-label="Nicolás Vazquez, Supraim">Nicolás</span>.<br />Creo apps para <em>la vida real.</em></h1>
      <p class="hero-copy">Diseño y desarrollo aplicaciones móviles útiles, cuidadas y fáciles de usar. Supraim es el espacio donde toman forma mis proyectos.</p>
      <div class="hero-actions"><a class="button" href="#apps">Explorar aplicaciones <span aria-hidden="true">↘</span></a><a class="text-link" href="#about">Un poco sobre mí <span>↗</span></a></div>
    </div>
    <div class="hero-art" aria-hidden="true"><div class="orbit"></div><div class="orbit-logos"><span class="orbit-badge" data-tech="Kotlin"><img src="/images/technologies/kotlin.svg" alt="" /></span><span class="orbit-badge" data-tech="React"><img src="/images/technologies/react.svg" alt="" /></span><span class="orbit-badge" data-tech="Angular"><img src="/images/technologies/angular.svg" alt="" /></span><span class="orbit-badge" data-tech=".NET"><img src="/images/technologies/dotnet.svg" alt="" /></span></div><div class="monogram"><img src="/images/brand/supraim-symbol.png" alt="" width="184" height="184" /></div></div>
  </section>
  <section class="featured-section" id="featured" data-reveal>
    <div class="featured-visual"><span class="featured-label">APP DESTACADA</span><button class="gallery-pause" type="button" data-carousel-toggle aria-label="Pausar carrusel" aria-pressed="false">Ⅱ</button><div class="featured-gallery" data-carousel data-interval="5600" role="region" aria-roledescription="carrusel" aria-label="Capturas de World Radio"><div class="gallery-stage">
      <button class="gallery-slide is-active" type="button" data-slide data-caption="Explora emisoras de todo el mundo" data-lightbox-group="world-radio" data-lightbox-src="/images/apps/worldradio-screen-full.jpg" data-lightbox-alt="Catálogo de emisoras de World Radio" aria-label="Ampliar captura 1 de World Radio" aria-roledescription="diapositiva"><img src="/images/apps/worldradio-screen.jpg" alt="" width="240" height="480" decoding="async" /><span>Ampliar ↗</span></button>
      <button class="gallery-slide" type="button" data-slide data-caption="Encuentra música por género" data-lightbox-group="world-radio" data-lightbox-src="/images/apps/worldradio-screen-full-2.jpg" data-lightbox-alt="Exploración de música por género en World Radio" aria-label="Ampliar captura 2 de World Radio" aria-roledescription="diapositiva" aria-hidden="true" inert><img src="/images/apps/worldradio-screen-2.jpg" alt="" width="240" height="480" loading="lazy" decoding="async" /><span>Ampliar ↗</span></button>
      <button class="gallery-slide" type="button" data-slide data-caption="Descubre emisoras por país" data-lightbox-group="world-radio" data-lightbox-src="/images/apps/worldradio-screen-full-3.jpg" data-lightbox-alt="Selección de países en World Radio" aria-label="Ampliar captura 3 de World Radio" aria-roledescription="diapositiva" aria-hidden="true" inert><img src="/images/apps/worldradio-screen-3.jpg" alt="" width="240" height="480" loading="lazy" decoding="async" /><span>Ampliar ↗</span></button>
    </div><div class="gallery-controls"><button type="button" data-carousel-prev aria-label="Captura anterior">‹</button><div class="gallery-dots" role="group" aria-label="Elegir captura"><button type="button" data-slide-to="0" aria-label="Mostrar captura 1" aria-pressed="true"></button><button type="button" data-slide-to="1" aria-label="Mostrar captura 2" aria-pressed="false"></button><button type="button" data-slide-to="2" aria-label="Mostrar captura 3" aria-pressed="false"></button></div><button type="button" data-carousel-next aria-label="Captura siguiente">›</button><span class="gallery-caption" data-carousel-caption aria-live="off">Explora emisoras de todo el mundo</span></div></div></div>
    <div class="featured-copy"><span class="section-kicker">PROYECTO DESTACADO · AUDIO</span><h2>World Radio</h2><p>Descubre emisoras en vivo de todo el mundo. Explora por país, género o popularidad, encuentra música, noticias y programas, y guarda tus favoritas.</p><div class="feature-tags"><span>Emisoras globales</span><span>Búsqueda y categorías</span><span>Favoritos</span></div><div class="featured-links"><a class="button" href="https://play.google.com/store/apps/details?id=com.supraim.worldradio" target="_blank" rel="noopener noreferrer">Ver en Google Play ↗</a><a href="/worldradio/privacy.es.html">Privacidad (ES)</a><a href="/worldradio/privacy.html">EN</a></div></div>
  </section>
  <section class="section" id="apps" data-reveal>
    <div class="section-heading"><div><span class="section-kicker">01 / PROYECTOS</span><h2>Aplicaciones</h2></div><a class="text-link" href="https://play.google.com/store/apps/dev?id=7088773385933324272" target="_blank" rel="noopener noreferrer">Ver perfil en Google Play <span>↗</span></a></div>
    <div class="app-grid app-grid-two">
      {apps.map((app) => <article class="app-card" data-reveal style={`--app-preview:${app.preview}`}><div class="app-top"><img class="app-icon" src={app.icon} alt="" width="40" height="40" loading="lazy" /><span class="app-type">{app.kind}</span></div><div class="app-preview"><button class="preview-trigger" type="button" data-lightbox-src={app.lightbox} data-lightbox-alt={app.imageAlt} aria-label={`Ampliar captura de ${app.name}`}><img src={app.screenshot} alt={app.imageAlt} width="240" height="480" loading="lazy" decoding="async" /><span>Ampliar ↗</span></button></div><h3>{app.name}</h3><p>{app.description}</p><div class="app-links"><a href={app.play} target="_blank" rel="noopener noreferrer">Ver en Google Play ↗</a><a href={app.privacyEs}>Privacidad (ES)</a><a href={app.privacyEn}>EN</a></div></article>)}
    </div>
  </section>
  <section class="section" id="about" data-reveal>
    <div class="about-row"><div><span class="section-kicker">02 / SOBRE MÍ</span><h2>Ideas útiles, experiencias simples.</h2></div><div class="about-meta"><p>Soy Nicolás Vazquez, desarrollador independiente detrás de Supraim y un apasionado por la tecnología y el desarrollo de software en todas sus formas: aplicaciones móviles, web, de escritorio y bots. Hoy mi foco principal está en Android, aunque estoy abierto a proyectos de desarrollo en distintas áreas.</p><div class="meta-line"><span>Foco actual</span><span>Android · Kotlin</span></div><div class="meta-line"><span>Abierto a</span><span>Empleo · Freelance · Colaboración</span></div><div class="social-links"><a href="https://github.com/supraim" target="_blank" rel="noopener noreferrer">GitHub <span>↗</span></a><a href="https://www.linkedin.com/in/nico-vaz/" target="_blank" rel="noopener noreferrer">LinkedIn <span>↗</span></a></div></div></div>
  </section>
  <section class="section" id="process" data-reveal>
    <div class="section-heading process-heading"><div><span class="section-kicker">03 / DE LA IDEA A PRODUCCIÓN</span><h2>Todo el camino del producto.</h2><p>Desde el primer concepto hasta una app publicada.</p></div></div>
    <div class="process-grid"><article><span>01</span><h3>Idea</h3><p>Definir el problema, el propósito y el alcance del producto.</p></article><article><span>02</span><h3>Desarrollo</h3><p>Diseñar y construir la experiencia, la lógica y las funciones.</p></article><article><span>03</span><h3>Preparación</h3><p>Resolver requisitos técnicos, políticas de Play y documentación necesaria.</p></article><article><span>04</span><h3>Lanzamiento</h3><p>Superar las revisiones y llevar el proyecto a producción.</p></article></div>
  </section>
  <section class="section" id="skills" data-reveal>
    <div class="section-heading tech-heading"><div><span class="section-kicker">04 / TECNOLOGÍAS</span><h2>Un perfil abierto a distintas plataformas.</h2><p>Android es mi foco actual; disfruto explorar distintas áreas del desarrollo.</p></div></div>
    <div class="skills-grid">
      <article data-reveal><span>01 / MOBILE</span><h3>Móvil</h3><div class="tech-list"><div class="tech-item"><span class="tech-logo"><img src="/images/technologies/kotlin.svg" alt="" loading="lazy" /></span><span>Kotlin</span></div><div class="tech-item"><span class="tech-logo"><img src="/images/technologies/react.svg" alt="" loading="lazy" /></span><span>React Native</span></div></div></article>
      <article data-reveal><span>02 / WEB</span><h3>Web</h3><div class="tech-list"><div class="tech-item"><span class="tech-logo"><img src="/images/technologies/react.svg" alt="" loading="lazy" /></span><span>React</span></div><div class="tech-item"><span class="tech-logo"><img src="/images/technologies/angular.svg" alt="" loading="lazy" /></span><span>Angular</span></div></div></article>
      <article data-reveal><span>03 / DESKTOP</span><h3>Escritorio</h3><div class="tech-list"><div class="tech-item"><span class="tech-logo"><img src="/images/technologies/java.svg" alt="" loading="lazy" /></span><span>Java</span></div><div class="tech-item"><span class="tech-logo"><img src="/images/technologies/csharp.svg" alt="" loading="lazy" /></span><span>C#</span></div><div class="tech-item"><span class="tech-logo"><img src="/images/technologies/c.svg" alt="" loading="lazy" /></span><span>C</span></div><div class="tech-item"><span class="tech-logo"><img src="/images/technologies/cplusplus.svg" alt="" loading="lazy" /></span><span>C++</span></div></div></article>
      <article data-reveal><span>04 / ENTERPRISE</span><h3>Plataformas empresariales</h3><div class="tech-list"><div class="tech-item"><span class="tech-logo"><img src="/images/technologies/dotnet.svg" alt="" loading="lazy" /></span><span>.NET</span></div><div class="tech-item"><span class="tech-logo tech-logo-wide"><img src="/images/technologies/jakartaee.svg" alt="" loading="lazy" /></span><span>Jakarta EE</span></div></div></article>
    </div>
  </section>
  <section class="section" id="contact" data-reveal>
    <div class="contact-panel"><div><span class="section-kicker">05 / CONTACTO</span><h2>¿Hablamos?</h2><p>Abierto a empleo, proyectos freelance y colaboraciones.</p></div><div class="contact-links"><a class="contact-email" href="mailto:supraim.dev@gmail.com"><span>supraim.dev@gmail.com</span><span class="contact-arrow" aria-hidden="true">↗</span></a><a href="https://github.com/supraim" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="https://www.linkedin.com/in/nico-vaz/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div></div>
  </section>
</SiteLayout>
